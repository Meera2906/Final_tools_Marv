# ============================================================
# Marvedge Tools — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# Supabase Client (required for Link Shortener + AI tools auth)
SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your_project_id.supabase.co

VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Supabase Service Role (required server-side for Link Shortener DB access, bypasses RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secret API key for authenticating machine-to-machine admin endpoints (/api/admin/links/*)
ADMIN_API_KEY=your_admin_api_key_here

# Cryptographic salt for anonymized SHA-256 IP hashing (min 32 chars)
IP_HASH_SALT=your_random_ip_hash_salt_here

# Secret key for HMAC-SHA256 signing of unverified reporting session cookies
REPORTING_SESSION_SECRET=your_random_reporting_session_secret_here

# Public canonical origin of the application used for short link generation (defaults to https://marvedge.com)
PUBLIC_SITE_URL=https://marvedge.com

# Enforce blocking of target URLs pointing to known link shorteners to prevent redirection chains (true/false)
BLOCK_SHORTENER_CHAINS=true

# Database migration connection URL (used by drizzle-kit for direct DB migrations)
# LOVABLE_DB_MIGRATION_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# OpenAI (required for AI tools: subtitle, voiceover, AI text tools)
# OPENAI_API_KEY=sk-...

# Add these in Netlify Dashboard → Site Settings → Environment Variables
